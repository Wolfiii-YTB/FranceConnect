# PostgreSQL local (docker compose up -d db)
POSTGRES_PASSWORD="replace-with-a-unique-local-password"
DATABASE_URL="postgresql://franceconnect:replace-with-a-unique-local-password@localhost:5432/franceconnect?schema=public"
IP_HASH_SECRET="replace-with-a-random-64-character-secret"

# Optional bootstrap administrator created by `npm run db:seed`.
# Set a unique password locally before seeding; never commit it.
ADMIN_EMAIL="admin@horizon.test"
ADMIN_PASSWORD=""

# Optional: explicitly create fictional demo accounts only when SEED_DEMO_DATA=true.
# Optional: overrides ADMIN_PASSWORD for fictional demo accounts. Leave blank to reuse ADMIN_PASSWORD.
DEMO_PASSWORD=""
SEED_DEMO_DATA="false"

# Optional self-hosted Jitsi Meet base URL (defaults to https://meet.jit.si).
JITSI_BASE_URL="https://meet.jit.si"
